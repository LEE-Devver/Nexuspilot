    "@nexuspilot/capabilities": "workspace:*",
    "@nexuspilot/domain": "workspace:*",
    "@nexuspilot/extensions": "workspace:*",
    "@nexuspilot/permissions": "workspace:*",
    "@nexuspilot/process": "workspace:*",
    "@nexuspilot/search": "workspace:*",
    "@nexuspilot/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "scripts": {
    "test": "corepack pnpm@10.15.0 --filter @nexuspilot/domain build && corepack pnpm@10.15.0 --filter @nexuspilot/shared build && corepack pnpm@10.15.0 --filter @nexuspilot/process build && corepack pnpm@10.15.0 --filter @nexuspilot/capabilities build && corepack pnpm@10.15.0 --filter @nexuspilot/extensions build && corepack pnpm@10.15.0 build && vitest run",
